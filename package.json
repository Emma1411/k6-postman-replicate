    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vite": "^6.4.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.1.0"
