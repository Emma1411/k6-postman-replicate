{
  "name": "api-engineering-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:worker && next dev",
    "build": "npm run build:worker && next build",
    "build:worker": "tsup",
    "dev:worker": "tsup --watch",
    "start": "next start",
    "lint": "eslint",
