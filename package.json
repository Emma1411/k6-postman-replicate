    "@lezer/highlight": "^1.2.5",
    "@reduxjs/toolkit": "^2.14.0",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "idb": "^8.0.4",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "postcss": "^8.5.33",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "^9.3.1",
    "recharts": "^3.10.1",
